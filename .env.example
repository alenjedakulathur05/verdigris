# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — real keys NEVER get committed or shipped
# to the browser. These are read only inside app/api/* route handlers,
# which run on the server.
# ─────────────────────────────────────────────────────────────────────

# ── AI: Verdigris's closing reply ────────────────────────────────────
# Two providers, tried in order. Whichever answers first wins; if both
# fail, a written in-character fallback is used and the visitor sees no
# difference. Either key may be omitted — a provider with no key is
# skipped, not treated as an outage.

# Google AI Studio — free, no card. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, e.g. gemini-2.5-flash
GEMINI_MODEL=

# Groq — free, no card. https://console.groq.com/keys
GROQ_API_KEY=
# Optional override, e.g. openai/gpt-oss-120b
GROQ_MODEL=

# Optional: change or shorten the chain, e.g. "groq,gemini" or "gemini"
AI_PROVIDER_ORDER=

# ── Email notification ───────────────────────────────────────────────
# Resend — free tier. https://resend.com/api-keys
RESEND_API_KEY=

# Where grievance notifications are delivered (your personal inbox).
NOTIFY_EMAIL_TO=

# Verified sender. Resend's shared sandbox sender works with no domain
# setup at all, which is what we start with. Note that with the sandbox
# sender, Resend only delivers to the address that owns the account.
NOTIFY_EMAIL_FROM=VERDIGRIS <onboarding@resend.dev>
